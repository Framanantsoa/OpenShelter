{
  "name": "OpenShelter",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "dotenv run -f .env.prod -- nuxt build",
    "dev": "dotenv run -f .env.dev -- nuxt dev",
    "generate": "dotenv run -f .env.prod -- nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:push": "dotenv run -f .env.dev -- drizzle-kit push",
    "db:drop": "dotenv run -f .env.dev -- npx tsx ./server/db/reset.ts",
    "db:generate": "dotenv run -f .env.dev -- drizzle-kit generate",
    "db:migrate": "dotenv run -f .env.dev -- drizzle-kit migrate",
    "db:studio": "dotenv run -f .env.dev -- drizzle-kit studio",
    "db:seed": "dotenv run -f .env.dev -- npx tsx ./server/db/seed.ts",
    "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed",
    "test": "dotenv run -f .env.test -- vitest run"
  },
  "dependencies": {
    "@nuxt/icon": "^2.6.1",
    "@nuxt/image": "^2.2.0",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "bcrypt": "^6.0.0",
    "crypto": "^1.0.1",
    "daisyui": "^5.7.50",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "jsonwebtoken": "^9.0.3",
    "nuxt": "^4.4.8",
    "pinia": "^4.1.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/test-utils": "^4.3.4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  }
}
